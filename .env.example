# Database
MONGODB_URI=                         # MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/easyed

# Auth
JWT_SECRET=                          # Minimum 64 random characters — generate with: openssl rand -hex 64
JWT_EXPIRY_DAYS=7

# Email
RESEND_API_KEY=                      # Resend API key. Or provide SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS to use Nodemailer instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Full URL, e.g. https://app.easyed.co
INVITE_TOKEN_EXPIRY_HOURS=72
OTP_EXPIRY_MINUTES=15

# Rate limiting (optional — Upstash Redis; falls back to an in-process limiter if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
